# Copy to `.env` before `docker compose up`. deploy.ps1 does this
# automatically on first run if `.env` does not already exist.
#
# SQLCheck AI never connects to Oracle or any application database.
# Formal production uses Windows-native Ollama/Gemma on the same host.
# The code also supports cloud providers for development, but production
# remains Ollama unless SQLCHECK_LLM_PROVIDER is explicitly changed.
#
# This template contains no secrets. Real .env files are gitignored.

# Active LLM provider. Formal host default: local Ollama.
SQLCHECK_LLM_PROVIDER=ollama

# Windows Ollama, reached from inside the container via the Docker Desktop
# host gateway. Do not point this at a public/LAN address — SQLCheck must be
# the only caller (PRD §46: browser never talks to Ollama directly).
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Must match a tag already pulled on the production host (`ollama list`).
OLLAMA_MODEL=gemma4:31b

# Per-request timeout to Ollama. The 31B model can take 30-90s for a normal
# reply; app.yaml's num_predict was raised to 3072 on 2026-09-16 (a full
# rewrite + 3 pieces of advice needs more than the old 1024), which pushes
# the longest replies further out, so this default was raised from 120 to
# 180. If production VRAM is tight and responses are consistently slow,
# lowering num_predict in app.yaml is usually a better fix than raising this
# further — check the container logs for `done_reason=length` first
# (that means output was truncated, not that the timeout was too short).
OLLAMA_TIMEOUT_SECONDS=180

# Context window forwarded as `options.num_ctx` on every /api/chat call.
# 2026-09-17: was 8192, which the real system prompt (~5,700 tokens) plus the
# 3072-token output budget overflows; app.yaml's num_ctx_default is 16384 and
# this file must match it. ai_service raises this tier automatically (doubling,
# never above OLLAMA_NUM_CTX_MAX) when a long SQL needs more, so this is the
# starting tier, not a hard cap.
OLLAMA_NUM_CTX=16384
#
# Optional upper bound for that automatic raise. Larger values cost VRAM for
# the KV cache; lower it if the production host is starved for VRAM.
# OLLAMA_NUM_CTX_MAX=32768

# Gemma4 "thinking" mode. Keep this false: with thinking on, the model was
# observed spending the entire num_predict budget on internal reasoning and
# returning an empty reply (done_reason=length -> "AI 暫時無法使用"). Off is
# also 3-5x faster. Only set true if you switch to a model that needs it.
OLLAMA_THINK=false

# Pattern Catalog compact context. Keep true for the normal runtime: only
# deterministic exact, non-OUT_OF_SCOPE matches are injected, under strict
# top-N/character budgets. Set false for a quick formal-host A/B or rollback
# without changing code; the legacy prompt/payload path then continues.
SQLCHECK_KNOWLEDGE_CONTEXT_ENABLED=true

# De-identified SQL archive (app/services/sql_archive.py). Enabled by
# default; set to false/0/no to disable entirely (nothing is written).
SQLCHECK_ARCHIVE_ENABLED=true

# Where the archive's monthly .jsonl files are written *inside the
# container*. docker-compose.yml mounts the host's ./data to /data, so the
# files land on the host at ./data/sql_archive/ regardless of this value
# unless you also change the compose mount.
SQLCHECK_ARCHIVE_DIR=/data/sql_archive

# ---------------------------------------------------------------------------
# Optional cloud-development provider (do not enable on the formal host)
# ---------------------------------------------------------------------------
# For a Mac development clone, prefer copying .env.mac.example instead.
# API keys must live only in .env / shell environment, never in llm.yaml.
#
# SQLCHECK_LLM_PROVIDER=ollama_cloud
# OLLAMA_API_KEY=
# OLLAMA_CLOUD_BASE_URL=https://ollama.com
# OLLAMA_CLOUD_MODEL=gemma4:31b-cloud
# OLLAMA_CLOUD_TIMEOUT_SECONDS=180
# OLLAMA_CLOUD_NUM_PREDICT=3072
# OLLAMA_CLOUD_NUM_CTX=16384
# OLLAMA_CLOUD_NUM_CTX_MAX=32768
# OLLAMA_CLOUD_TEMPERATURE=0.2
# OLLAMA_CLOUD_TOP_P=0.95
# OLLAMA_CLOUD_TOP_K=64
# OLLAMA_CLOUD_THINK=false
#
# Gemini adapter 仍保留為備援：
# SQLCHECK_LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemma-4-31b-it

