# Copy to `.env` before `docker compose up`. deploy.ps1 does this
# automatically on first run if `.env` does not already exist.
#
# SQLCheck 2.0 never connects to any database (PRD §0.6) — the only external
# connection is to the Windows-native Ollama instance on the same host
# (PRD §46). None of these values are secrets in the usual sense, but keep
# this file out of source control anyway (see .gitignore) since production
# values (real host IP) differ from developer defaults.

# Windows Ollama, reached from inside the container via the Docker Desktop
# host gateway. Do not point this at a public/LAN address — SQLCheck must be
# the only caller (PRD §46: browser never talks to Ollama directly).
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Must match a tag already pulled on the production host (`ollama list`).
OLLAMA_MODEL=gemma4:31b-it-qat

# Per-request timeout to Ollama. The 31B model can take 30-90s; keep this
# comfortably above that.
OLLAMA_TIMEOUT_SECONDS=120

# Context window forwarded as `options.num_ctx` on every /api/chat call.
OLLAMA_NUM_CTX=8192
