# --- Python / backend ---
backend/.venv/
**/__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/

# Frontend build output copied into the backend image at Docker build time —
# never hand-committed, only ever produced by `npm run build`.
backend/static/*
!backend/static/.gitkeep

# --- Node / frontend ---
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*

# --- Secrets / environment ---
.env
.env.*
!.env.example
!.env.mac.example

# --- TLS certificates (production-only, generated by deploy.ps1 / certgen.py) ---
certs/*
!certs/.gitkeep

# --- De-identified SQL archive (production-only; see app/services/sql_archive.py) ---
data/*
!data/.gitkeep

# --- Deploy logs ---
deploy/logs/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Misc ---
*.log
coverage/
htmlcov/
.playwright-mcp/
