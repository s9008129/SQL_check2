# Mac 開發環境範本（不需要 Docker、不需要本機 Ollama）
# 使用方式：
#   cp .env.mac.example .env
#   編輯 .env，把 OLLAMA_API_KEY= 換成自己的 Ollama Cloud API Key
#   ./scripts/dev-mac.sh
#
# .env 已被 .gitignore 排除；不要把真實 API Key commit 到 GitHub。

SQLCHECK_LLM_PROVIDER=ollama_cloud
OLLAMA_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://ollama.com
OLLAMA_CLOUD_MODEL=gemma4:31b-cloud
OLLAMA_CLOUD_TIMEOUT_SECONDS=180
OLLAMA_CLOUD_NUM_PREDICT=3072
OLLAMA_CLOUD_NUM_CTX=16384
OLLAMA_CLOUD_NUM_CTX_MAX=32768
OLLAMA_CLOUD_TEMPERATURE=0.2
OLLAMA_CLOUD_TOP_P=0.95
OLLAMA_CLOUD_TOP_K=64
OLLAMA_CLOUD_THINK=false

# Compact Context 正常開啟；要做 ON/OFF A/B 時再切 false。
SQLCHECK_KNOWLEDGE_CONTEXT_ENABLED=true

# Mac 不經 Docker，蒐集檔直接放在 Repo 根目錄 data/sql_archive。
# sql_archive.py 寫入前會先去識別化；data/ 整個目錄由 Git 忽略。
SQLCHECK_ARCHIVE_ENABLED=true
SQLCHECK_ARCHIVE_DIR=data/sql_archive
